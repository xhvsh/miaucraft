{
  "_meta_": {
    "languageCode": "pl",
    "languageName": "Polski",
    "sourceLanguage": "en",
    "usage": "Fill in the 'pl' value for every entry. Everything else is auto-generated and ready to hand to an implementation AI. Keep {placeholders} exactly as written - they are replaced at runtime with numbers/usernames/etc. (e.g. '{count} online' keeps '{count}'). Entries with 'doNotTranslate: true' are technical values; they can stay untranslated even if you leave the 'pl' empty."
  },
  "_notes_": {
    "dynamicMinecraftNames": "Item/block/mob stat names (e.g. 'Oak Log', 'Zombie') and achievement titles/descriptions come from the DATABASE, not the code. They are title-cased at runtime in js/lib/statPresets.js and can NOT be listed statically here. They will need a separate look-up table at implementation time (e.g. Minecraft's own Polish lang file for item/mob names).",
    "brandName": "'MIAUCRAFT' and '@xhvsh' are proper nouns - keep them untranslated.",
    "roleNames": "'user' / 'admin' / 'owner' / 'guest' are shown in the nav chip and admin tables. They are also permission keys in the code (Auth.can()) so they must stay untouched in logic, but their DISPLAY text can be translated if desired. Leave 'pl' empty to keep the English role words.",
    "pluralForms": "Polish has complex pluralization (1, 2-4, 5+) vs. English's simple singular/plural. The implementing AI should use a plural-aware helper (e.g. Intl.PluralRules) for 'about {n} ago', '{n} online', 'Top {n}' style strings.",
    "timeAbbreviations": "Time values use short abbreviations like '14d 2h 5m (338h)' (from js/lib/statPresets.js formatStatValue). 'd/h/m' are commonly understood in Polish too, but can be localized ('d/g/m') if preferred.",
    "coordinateFormatExamples": "The coordinate-copy-format options in Settings display literal examples like 'x 100, y 64, z -200'. The format itself is not translatable; only the example labels are listed here (optional)."
  },
